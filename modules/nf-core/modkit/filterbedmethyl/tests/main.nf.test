nextflow_process {

    name "Test Process MODKIT_FILTERBEDMETHYL"
    script "../main.nf"
    process "MODKIT_FILTERBEDMETHYL"

    tag "modules"
    tag "modules_nfcore"
    tag "modkit"
    tag "modkit/filterbedmethyl"

    test("homo sapiens - bedMethyl filter - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'HG002' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bedmethyl/HG002_PAW70337_giab_10reads.bedmethyl.gz',
                         checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bedmethyl/HG002_PAW70337_giab_10reads.bedmethyl.gz.tbi',
                         checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("homo sapiens - bedMethyl filter - default threshold") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'HG002' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bedmethyl/HG002_PAW70337_giab_10reads.bedmethyl.gz',
                         checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bedmethyl/HG002_PAW70337_giab_10reads.bedmethyl.gz.tbi',
                         checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.bedmethyl[0][1]).exists() },
                { assert path(process.out.bedmethyl[0][1]).size() > 0 },
                { assert path(process.out.bedmethyl[0][2]).exists() },
                { assert path(process.out.bedmethyl[0][2]).size() > 0 },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
